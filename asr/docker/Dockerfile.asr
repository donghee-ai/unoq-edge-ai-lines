# asr-dev container for UNO Q KWS development
# Host-side: model conversion, validation, host baseline benchmark.
# Device-side runtime is venv-unoq (separate, not this container).

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# System packages
#   python3.10 / pip / venv = base runtime
#   libportaudio2 + portaudio19-dev = sounddevice runtime + build header
#   libsndfile1 = librosa wav reading
#   ffmpeg = audio format conversion (optional but commonly needed)
#   git + wget + curl = model / data fetch
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.10 \
        python3-pip \
        python3.10-venv \
        libportaudio2 \
        portaudio19-dev \
        libsndfile1 \
        ffmpeg \
        git \
        wget \
        curl \
        ca-certificates \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

# Non-root user matching host UID/GID (build-arg overridable)
ARG USER_NAME=dev
ARG USER_UID=1000
ARG USER_GID=1000
RUN groupadd -g ${USER_GID} ${USER_NAME} && \
    useradd -m -u ${USER_UID} -g ${USER_GID} -s /bin/bash ${USER_NAME}

# Python packages — install via lock file when available, else requirements.txt
WORKDIR /tmp
COPY requirements-asr.txt requirements-asr.lock* /tmp/
RUN python3 -m pip install --upgrade pip setuptools wheel && \
    if [ -f /tmp/requirements-asr.lock ]; then \
        python3 -m pip install -r /tmp/requirements-asr.lock ; \
    else \
        python3 -m pip install -r /tmp/requirements-asr.txt ; \
    fi && \
    rm -f /tmp/requirements-asr.txt /tmp/requirements-asr.lock

USER ${USER_NAME}
WORKDIR /work

CMD ["bash"]
