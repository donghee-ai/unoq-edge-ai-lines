# unoq-kws container
# Host-side: KWS TFLite 모델 introspection + 호스트 baseline latency + 디바이스 호환성 검증
# Device-side runtime: venv-unoq + ai-edge-litert (TFLite 직접 추론)
#
# 패턴은 unoq-pose:22.04 와 동일 — non-root, requirements-first, 최소 의존성.

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# System packages — 본 라인 최소 의존성
#   python3.10 / pip / venv = base runtime
#   libportaudio2 + portaudio19-dev = sounddevice 의존 (마이크 캡처)
#   libsndfile1 = soundfile / librosa wav I/O
#   libgomp1 = numpy/librosa OpenMP
#   wget + curl = 모델 다운로드
#   ca-certificates + git = mlcommons/tiny clone fallback
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.10 \
        python3-pip \
        python3.10-venv \
        libportaudio2 \
        portaudio19-dev \
        libsndfile1 \
        libgomp1 \
        wget \
        curl \
        git \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Non-root user matching host UID/GID (pose/vision Dockerfile 패턴)
ARG USER_NAME=dev
ARG USER_UID=1000
ARG USER_GID=1000
RUN groupadd -g ${USER_GID} ${USER_NAME} && \
    useradd -m -u ${USER_UID} -g ${USER_GID} -s /bin/bash ${USER_NAME}

WORKDIR /tmp
COPY requirements-kws.txt requirements-kws.lock* /tmp/
RUN python3 -m pip install --upgrade pip setuptools wheel && \
    if [ -f /tmp/requirements-kws.lock ]; then \
        python3 -m pip install -r /tmp/requirements-kws.lock ; \
    else \
        python3 -m pip install -r /tmp/requirements-kws.txt ; \
    fi && \
    rm -f /tmp/requirements-kws.txt /tmp/requirements-kws.lock

USER ${USER_NAME}
WORKDIR /work

CMD ["bash"]
